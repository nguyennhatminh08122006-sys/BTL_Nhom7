@model CartDetailsVm
@{ ViewData["Title"] = $"Giỏ hàng #{Model.Id}"; }
<div class="admin-page-heading">
    <div><h1>Giỏ hàng #@Model.Id</h1><p class="admin-muted">Tạo lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p></div>
    <a class="admin-secondary-button" href="@Model.ReturnUrl">Quay lại danh sách</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="admin-alert admin-alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="admin-alert admin-alert-error" role="alert">@error</div>
}

<section class="admin-panel admin-cart-owner">
    <div>
        <h2>Chủ giỏ hàng</h2>
        <p><a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId">@Model.CustomerName</a></p>
        <p class="admin-muted">@Model.CustomerEmail</p>
    </div>
    <form asp-area="Admin" asp-controller="Carts" asp-action="Delete" method="post" onsubmit="return confirm(this.dataset.confirmMessage)" data-confirm-message="Xác nhận xóa toàn bộ giỏ của @Model.CustomerName (@Model.CustomerEmail)? Tồn kho không thay đổi.">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button class="admin-danger-button" type="submit">Xóa toàn bộ giỏ</button>
    </form>
</section>

<section class="admin-panel">
    <h2>Các dòng hàng</h2>
    @if (Model.Items.Count == 0)
    {
        <p class="admin-cart-empty">Giỏ trống</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table admin-cart-lines">
                <thead><tr><th>Sản phẩm</th><th>Size</th><th>Số lượng</th><th>Đơn giá hiện tại</th><th>Thành tiền</th><th>Tồn kho</th><th>Cảnh báo</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img class="admin-cart-thumb" src="@item.ImageUrl" alt="@item.ProductName" loading="lazy" />
                            }
                            else
                            {
                                <span class="admin-cart-thumb admin-cart-fallback" style="background:@item.Color">@item.Icon</span>
                            }
                            @item.ProductName
                        </td>
                        <td>@item.Size</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.Money()</td>
                        <td>@((item.UnitPrice * item.Quantity).Money())</td>
                        <td>@item.StockQuantity</td>
                        <td>
                            @if (item.Warnings.Count == 0)
                            {
                                <span class="admin-muted">—</span>
                            }
                            else
                            {
                                @foreach (var warning in item.Warnings)
                                {
                                    <span class="admin-cart-warning">@warning</span>
                                }
                            }
                        </td>
                        <td>
                            <form asp-area="Admin" asp-controller="Carts" asp-action="DeleteItem" method="post" onsubmit="return confirm(this.dataset.confirmMessage)" data-confirm-message="Xác nhận xóa dòng hàng này khỏi giỏ của @Model.CustomerName (@Model.CustomerEmail)? Tồn kho không thay đổi.">
                                <input type="hidden" name="cartId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button class="admin-danger-button" type="submit">Xóa dòng</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="4">Tổng giá trị theo giá hiện tại</th><th>@Model.EstimatedValue.Money()</th><td colspan="3"></td></tr></tfoot>
            </table>
        </div>
    }
</section>
