@model List<CategoryRowVm>
@{ ViewData["Title"] = "Quản lý danh mục"; }
<div class="admin-page-heading">
    <div>
        <h1>Danh mục</h1>
        <p class="admin-muted">Quản lý danh mục hiển thị trong cửa hàng</p>
    </div>
    <a class="admin-primary-button" asp-area="Admin" asp-controller="Categories" asp-action="Create">Thêm danh mục</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="admin-alert admin-alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="admin-alert admin-alert-error" role="alert">@error</div>
}

<section class="admin-panel">
    @if (Model.Count == 0)
    {
        <p class="admin-muted">Chưa có danh mục nào.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Id</th><th>Tên</th><th>Slug</th><th>Icon</th><th>Số sản phẩm</th><th>Thao tác</th></tr></thead>
                <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Name</td>
                        <td><code>@category.Slug</code></td>
                        <td class="admin-icon-cell">@category.Icon</td>
                        <td>@category.ProductCount</td>
                        <td>
                            <div class="admin-row-actions">
                                <a class="admin-secondary-button" asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id">Sửa</a>
                                <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                    <button class="admin-danger-button" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
