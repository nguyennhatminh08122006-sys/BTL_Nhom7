@model UserDetailsVm
@{ ViewData["Title"] = $"Tài khoản #{Model.Id}"; }
<div class="admin-page-heading">
    <div>
        <h1>Tài khoản #@Model.Id
            @if (Model.IsCurrentUser)
            {
                <span class="admin-user-you">Bạn</span>
            }
        </h1>
        <p class="admin-muted">Thông tin và hoạt động của tài khoản</p>
    </div>
    <a class="admin-secondary-button" asp-area="Admin" asp-controller="Users" asp-action="Index">Quay lại danh sách</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="admin-alert admin-alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="admin-alert admin-alert-error" role="alert">@error</div>
}

<section class="admin-panel admin-user-detail-panel">
    <div>
        <h2>Thông tin tài khoản</h2>
        <dl class="admin-detail-list">
            <dt>Id</dt><dd>@Model.Id</dd>
            <dt>Họ tên</dt><dd>@Model.FullName</dd>
            <dt>Email</dt><dd>@Model.Email</dd>
            <dt>Số điện thoại</dt><dd>@(Model.Phone ?? "—")</dd>
            <dt>Vai trò</dt><dd><span class="admin-user-role @(Model.Role == "Admin" ? "admin-user-role-admin" : "")">@Model.Role</span></dd>
            <dt>Trạng thái</dt><dd><span class="admin-user-status @(Model.IsLocked ? "admin-user-status-locked" : "admin-user-status-active")">@(Model.IsLocked ? "Đã khóa" : "Hoạt động")</span></dd>
        </dl>
    </div>
    <div class="admin-user-detail-actions">
        @if (Model.IsCurrentUser)
        {
            <p class="admin-muted">Không thể khóa hoặc xóa tài khoản đang đăng nhập.</p>
        }
        else
        {
            @if (Model.DisableLock)
            {
                <button class="admin-secondary-button" type="button" disabled title="@Model.LockDisabledReason">Khóa</button>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users" asp-action="ToggleLock" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="locked" value="@(!Model.IsLocked)" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button class="admin-secondary-button" type="submit">@(Model.IsLocked ? "Mở khóa" : "Khóa")</button>
                </form>
            }
            @if (Model.DisableDelete)
            {
                <button class="admin-danger-button" type="button" disabled title="@Model.DeleteDisabledReason">Xóa</button>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post" onsubmit="return confirm(this.dataset.confirmMessage)" data-confirm-message="Xác nhận xóa tài khoản @Model.FullName (@Model.Email)?">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Model.DeleteReturnUrl" />
                    <button class="admin-danger-button" type="submit">Xóa</button>
                </form>
            }
        }
    </div>
</section>

<section class="admin-stat-grid">
    <article class="admin-stat"><span>Tổng số đơn hàng</span><strong>@Model.OrderCount</strong></article>
    <article class="admin-stat"><span>Tổng tiền đơn không bị hủy</span><strong>@Model.NonCancelledOrderTotal.Money()</strong></article>
    <article class="admin-stat"><span>Loại sản phẩm trong giỏ</span><strong>@Model.CartProductTypeCount</strong></article>
</section>

<section class="admin-panel">
    <h2>Đơn hàng theo trạng thái</h2>
    <div class="admin-stat-grid admin-status-grid">
        @foreach (var item in Model.OrderStatusCounts)
        {
            <article class="admin-stat"><span class="admin-status @OrderStatus.GetBadgeClass(item.Status)">@item.Status</span><strong>@item.Count</strong></article>
        }
    </div>
</section>

<section class="admin-panel">
    <h2>10 đơn hàng gần nhất</h2>
    @if (Model.RecentOrders.Count == 0)
    {
        <p class="admin-muted">Tài khoản chưa có đơn hàng.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
                <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.Total.Money()</td>
                        <td><span class="admin-status @OrderStatus.GetBadgeClass(order.Status)">@order.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
