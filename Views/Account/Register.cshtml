@model RegisterVm
@{ ViewData["Title"] = "Đăng ký"; }
<div class="form-box">
    <h2>Đăng ký tài khoản</h2>
    <form asp-action="Register" method="post">
        <label>Họ và tên<input asp-for="FullName" /></label>
        <span asp-validation-for="FullName" class="err"></span>
        <label>Email<input asp-for="Email" autocomplete="email" /></label>
        <span asp-validation-for="Email" class="err"></span>
        <label>Số điện thoại<input asp-for="Phone" /></label>
        <span asp-validation-for="Phone" class="err"></span>
        <label>Mật khẩu<input asp-for="Password" autocomplete="new-password" /></label>
        <span asp-validation-for="Password" class="err"></span>
        <label>Nhập lại mật khẩu<input asp-for="ConfirmPassword" autocomplete="new-password" /></label>
        <span asp-validation-for="ConfirmPassword" class="err"></span>
        <button class="btn">Tạo tài khoản</button>
    </form>
    <p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>
