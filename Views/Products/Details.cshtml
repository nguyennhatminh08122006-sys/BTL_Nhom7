@model Product
@{ ViewData["Title"] = Model.Name; var related = (List<Product>)ViewBag.Related; var sizes = Model.Sizes.Split(','); }
<p class="crumb"><a asp-controller="Products" asp-action="Index">Sản phẩm</a> / <a asp-controller="Products" asp-action="Index" asp-route-category="@Model.Category?.Slug">@Model.Category?.Name</a></p>
<div class="detail">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img class="thumb big" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
    }
    else
    {
        <div class="thumb big" style="background:@Model.Color">@Model.Category?.Icon</div>
    }
    <div>
        <h1>@Model.Name</h1>
        <div class="price lg">
            <b>@Model.Price.Money()</b>
            @if (Model.OldPrice.HasValue) { <s>@Model.OldPrice.Value.Money()</s> }
        </div>
        <p class="hint">@(Model.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")</p>
        <p>@Model.Description</p>
        @if (Model.StockQuantity <= 0)
        {
            <button class="btn" disabled>Hết hàng</button>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập để mua hàng</a>
        }
        else
        {
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <fieldset class="sizes">
                    <legend>Kích cỡ</legend>
                    @for (var i = 0; i < sizes.Length; i++)
                    {
                        <label><input type="radio" name="size" value="@sizes[i]" checked="@(i == 0)" /><span>@sizes[i]</span></label>
                    }
                </fieldset>
                <label class="qty">Số lượng <input type="number" name="quantity" value="1" min="1" max="@(Math.Min(20, Model.StockQuantity))" /></label>
                <button class="btn">Thêm vào giỏ hàng</button>
            </form>
        }
    </div>
</div>
@if (related.Count > 0)
{
    <h2>Sản phẩm liên quan</h2>
    <div class="grid">@foreach (var p in related) { <partial name="_ProductCard" model="p" /> }</div>
}
